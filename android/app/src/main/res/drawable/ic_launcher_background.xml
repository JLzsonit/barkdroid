<?xml version="1.0" encoding="utf-8"?>
<!-- 图标背景层：对角深紫渐变 + 左上光晕 + 右下暖紫反光（与 scripts/gen_icon.py 预览同参数） -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 主渐变 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="12"
                android:startY="0"
                android:endX="96"
                android:endY="108">
                <item android:offset="0" android:color="#FF7A66F0" />
                <item android:offset="0.45" android:color="#FF4C39B8" />
                <item android:offset="1" android:color="#FF201A46" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 左上光晕：液态玻璃的光源感 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="24"
                android:centerY="16"
                android:gradientRadius="64">
                <item android:offset="0" android:color="#2EFFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 右下反光 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="88"
                android:centerY="98"
                android:gradientRadius="58">
                <item android:offset="0" android:color="#26C9B2FF" />
                <item android:offset="1" android:color="#00C9B2FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
